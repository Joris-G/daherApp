{
  "name": "moldingApp",
  "version": "1.6.4",
  "author": "Joris GRANGIER",
  "homepage": "",
  "scripts": {
    "ng": "ng",
    "start": "ionic serve",
    "start-home": "ionic serve --host=192.168.2.2 --port=8100",
    "start-lab": "ionic serve --lab",
    "start-pwa": "ionic build --configuration=qual && http-server -p 8080 -c-1 moldingAppQual",
    "mock:server": "nodemon 'server.js'",
    "build": "ionic build --prod",
    "build-p": "ionic build --prod",
    "build-q": "ionic build --configuration=qual",
    "test": "ng test --passWithNoTests --runInBand",
    "lint": "ng lint --fix",
    "e2e": "ng e2e",
    "cypress:open": "cypress open",
    "build-p-q": "npm run build-p && npm run build-q",
    "build:ci": "ionic build --configuration=qual --base-href /TEST/",
    "compodoc:build": "compodoc -p tsconfig.doc.json --language fr-FR --theme original --hideGenerator",
    "compodoc:build-and-serve": "compodoc -p tsconfig.doc.json --language fr-FR -s -o --theme original --hideGenerator",
    "compodoc:serve": "compodoc -s -o",
    "prepare": "husky"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~21.0.6",
    "@angular/cdk": "^21.0.5",
    "@angular/common": "~21.0.6",
    "@angular/core": "~21.0.6",
    "@angular/forms": "~21.0.6",
    "@angular/platform-browser": "~21.0.6",
    "@angular/platform-browser-dynamic": "~21.0.6",
    "@angular/router": "~21.0.6",
    "@angular/service-worker": "~21.0.6",
    "@capacitor/android": "^6.2.1",
    "@capacitor/camera": "^6.1.2",
    "@capacitor/core": "^6.2.1",
    "@capacitor/filesystem": "^6.0.3",
    "@capacitor/haptics": "^6.0.2",
    "@capacitor/ios": "^6.2.1",
    "@capacitor/keyboard": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2",
    "@ctrl/tinycolor": "^4.2.0",
    "@primeuix/themes": "^2.0.2",
    "@tinymce/tinymce-angular": "^9.1.1",
    "@types/dom-to-image": "^2.6.4",
    "@types/jspdf": "^2.0.0",
    "chart.js": "^3.9.1",
    "chartjs-plugin-datalabels": "^2.2.0",
    "dom-to-image": "^2.6.0",
    "jsbarcode": "^3.11.5",
    "jspdf": "^2.5.1",
    "msw": "^2.12.2",
    "ngx-editor": "18.0.0",
    "ngx-webcam": "^0.4.1",
    "pdfmake": "^0.2.9",
    "phonegap-plugin-barcodescanner": "^8.1.0",
    "primeicons": "^7.0.0",
    "primeng": "^21.0.2",
    "rxjs": "~7.8.1",
    "socket.io-client": "^4.6.1",
    "swiper": "^8.4.7",
    "tinymce": "^6.8.2",
    "tslib": "^2.6.2",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.0.4",
    "@angular-eslint/builder": "~15.2.1",
    "@angular-eslint/eslint-plugin": "~15.2.1",
    "@angular-eslint/eslint-plugin-template": "~15.2.1",
    "@angular-eslint/template-parser": "~15.2.1",
    "@angular/cli": "~21.0.4",
    "@angular/compiler": "~21.0.6",
    "@angular/compiler-cli": "~21.0.6",
    "@angular/language-service": "~21.0.6",
    "@capacitor/cli": "^6.2.1",
    "@compodoc/compodoc": "^1.1.32",
    "@tsconfig/cypress": "^1.0.1",
    "@types/jasmine": "~4.3.0",
    "@types/node": "^18.19.3",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "cypress": "^12.17.4",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^61.5.0",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "husky": "^9.1.7",
    "jasmine-core": "~4.6.0",
    "jasmine-spec-reporter": "~7.0.0",
    "json-server": "^0.17.4",
    "karma": "^6.4.2",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "lint-staged": "^16.2.7",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "description": "Applications DAHER. Créées par joris-web-dev",
  "msw": {
    "workerDirectory": [
      "src"
    ]
  },
  "lint-staged": {
    "src/**/*.{ts,html}": [
      "eslint --fix",
      "jest --findRelatedTests --bail --passWithNoTests --runInBand"
    ]
  }
